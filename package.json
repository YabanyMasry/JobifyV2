{
  "name": "jobify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:all": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "npm run dev:all"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
